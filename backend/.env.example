# CZZ CRM — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME="CZZ CRM"
ENVIRONMENT=development
DEBUG=true

# ── JWT (gere com: python -c "import secrets; print(secrets.token_hex(64))")
JWT_SECRET_KEY=dev-secret-key-change-in-production-generate-with-secrets-token-hex-64
JWT_REFRESH_SECRET_KEY=dev-refresh-secret-key-change-in-production-generate-different-one

# ── CORS
ALLOWED_ORIGINS=http://localhost:3000

# ── Rate Limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute

# ── Logging
LOG_LEVEL=INFO
LOG_FILE=logs/crm.log

# ── Supabase (preencher quando integrar o banco real)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
